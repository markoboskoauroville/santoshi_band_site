/audio/*/index.m3u8
  Content-Type: application/vnd.apple.mpegurl
  Cache-Control: public, max-age=3600
/audio/*.m4s
  Content-Type: video/iso.segment
  Cache-Control: public, max-age=31536000, immutable
/audio/*/init.mp4
  Content-Type: audio/mp4
  Cache-Control: public, max-age=31536000, immutable
